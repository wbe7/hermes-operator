{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["networkPolicy"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["IfNotPresent", "Always", "Never"]},
        "pullSecrets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "resources": {"type": "object"},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcementConfirmed", "podCIDRs", "serviceCIDRs", "nodeCIDRs", "infrastructureCIDRs", "dns"],
      "properties": {
        "enforcementConfirmed": {"const": true},
        "podCIDRs": {"$ref": "#/$defs/nonEmptyCIDRs"},
        "serviceCIDRs": {"$ref": "#/$defs/nonEmptyCIDRs"},
        "nodeCIDRs": {"$ref": "#/$defs/nonEmptyCIDRs"},
        "infrastructureCIDRs": {"$ref": "#/$defs/cidrs"},
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "podSelector": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespaceLabels", "podLabels"],
              "properties": {
                "namespaceLabels": {"$ref": "#/$defs/labels"},
                "podLabels": {"$ref": "#/$defs/labels"}
              }
            },
            "resolverIPs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 2}
            }
          },
          "anyOf": [{"required": ["podSelector"]}, {"required": ["resolverIPs"]}]
        }
      }
    }
  },
  "$defs": {
    "cidrs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[^[:space:]]+/[0-9]{1,3}$"}
    },
    "nonEmptyCIDRs": {"$ref": "#/$defs/cidrs", "minItems": 1},
    "labels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string"}
    }
  }
}
